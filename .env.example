NODE_ENV=development
# api
# The API's origin, e.g. https://api.example.com — the browser calls it
# directly, there is no /api/* proxy any more. Inlined into the bundle at build
# time, so changing it needs a rebuild, not a restart.
#
# For this to carry the session cookie, the API needs COOKIE_DOMAIN set to the
# shared parent domain and this app's origin in its ALLOWED_ORIGINS.
NEXT_PUBLIC_API_URL=http://localhost:3000


# The same origin, for server-side rendering (sitemap, generateMetadata).
# Server code cannot read NEXT_PUBLIC_* reliably at request time and does not
# need to. Keep the two the same.
API_URL=http://localhost:3000

#sentry
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
#posthog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

