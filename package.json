{
  "name": "clent",
  "version": "0.1.0",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=--dns-result-order=ipv4first next dev --turbopack -p 3001",
    "build": "NODE_OPTIONS=--dns-result-order=ipv4first next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:fix": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "check-all": "npm run lint && npm run format:check && npm run type-check && npm run test",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@next/third-parties": "^16.0.5",
    "@sentry/nextjs": "^10.22.0",
    "@tanstack/react-query": "^5.90.2",
    "@tiptap/extension-color": "^3.10.3",
    "@tiptap/extension-image": "^3.10.3",
    "@tiptap/extension-link": "^3.10.3",
    "@tiptap/extension-placeholder": "^3.10.3",
    "@tiptap/extension-text-align": "^3.10.3",
    "@tiptap/extension-text-style": "^3.10.3",
    "@tiptap/extension-underline": "^3.10.3",
    "@tiptap/pm": "^3.10.3",
    "@tiptap/react": "^3.10.3",
    "@tiptap/starter-kit": "^3.10.3",
    "axios": "^1.12.2",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^1.0.2",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.22",
    "import-in-the-middle": "3.2.0",
    "js-cookie": "^3.0.5",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.545.0",
    "next": "^15.5.9",
    "posthog-js": "^1.284.0",
    "posthog-node": "^5.11.0",
    "react": "^19.1.2",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.1.2",
    "react-hook-form": "^7.64.0",
    "react-photoswipe-gallery": "^2.2.7",
    "react-select-country-list": "^2.2.3",
    "recharts": "^3.2.1",
    "require-in-the-middle": "8.0.1",
    "sonner": "^2.0.7",
    "swiper": "^11.2.10",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/jspdf": "^2.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-select-country-list": "^2.2.3",
    "critters": "^0.0.23",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
